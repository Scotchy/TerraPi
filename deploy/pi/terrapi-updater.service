[Unit]
Description=TerraPi release reconciliation
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/terrapi/updater.py
Restart=always
RestartSec=15
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/terrapi
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
