[Unit]
Description=TerraPi controller
After=network-online.target
Wants=network-online.target

[Service]
User=terrapi
Group=terrapi
SupplementaryGroups=gpio
WorkingDirectory=/var/lib/terrapi/current
ExecStart=/usr/bin/python3 /usr/local/lib/terrapi/start_controller.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=multi-user.target
